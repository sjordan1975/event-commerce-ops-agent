GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_COORDINATOR_MODEL=gemini-2.5-flash
# Model for the narrative LLM call inside build_event_context; swap independently of GEMINI_MODEL (model swap is the last rung of the remediation ladder).
GEMINI_NARRATIVE_MODEL=gemini-2.5-flash-lite
# Model for image embeddings in find_similar_assets (gemini-embedding-2 = 3072-dim, cosine).
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Model for per-asset Vision scoring in score_assets_with_vision. flash (not flash-lite) —
# judgment-laden scoring + detected_subjects hallucination surface warrants the upgrade (D-028).
GEMINI_VISION_MODEL=gemini-2.5-flash
# Model for Gemini image generation (t-shirt mockup in execute_approved_campaigns).
GEMINI_IMAGE_MODEL=gemini-3-pro-image
PROMPT_VERSION=v3
MONGODB_URI=
MDB_MCP_API_CLIENT_ID=
MDB_MCP_API_CLIENT_SECRET=
# Atlas Vector Search index name on assets.embedding (created by scripts/setup_vector_index.py).
VECTOR_INDEX_NAME=assets_embedding_index
# Maximum redraft cycles before the coordinator cap fires (tool-level hard cap; default 3).
MAX_REDRAFT_CYCLES=3
# Max items surfaced per pool (exploitation + discovery) after LLM ranking — functional reranker cap.
# Demo-calibrated at 5 (max 10 total). Raise for production workloads with larger batches.
QUEUE_MAX_PER_POOL=5
# Max concurrent Gemini API calls in Steps 3 (embedding).
GEMINI_CONCURRENCY_LIMIT=5
# Max concurrent Gemini image-gen + Shopify calls in execute_approved_campaigns.
# Lower than GEMINI_CONCURRENCY_LIMIT — image gen is slower and more expensive to serve.
GEMINI_IMAGE_CONCURRENCY=2
# Similarity cutoff for exploitation vs discovery queue split (default 0.75).
# Empirically calibrated at 0.90 for the demo corpus: produces 7 exploitation (Batch 1)
# and 3 exploitation (Batch 2), matching the 6-8 vs 2-3 target contrast.
# See docs/plans/demo-corpus.md § Similarity findings.
QUEUE_EXPLOITATION_SIMILARITY_CUTOFF=0.90
# Set to 1 to enable verbose pipeline logging (LLM call start/done with latency and scores).
# Omit or leave blank to suppress (default off — logs are noisy at INFO level).
LOG_PIPELINE=
# Shopify Dev Dashboard custom app. SHOPIFY_STORE_URL = your .myshopify.com domain (no trailing slash).
# SHOPIFY_CLIENT_ID + SHOPIFY_CLIENT_SECRET: from Dev Dashboard → Apps → your app settings.
# Exchanged for a short-lived Admin API access token via client credentials grant (D-036).
# Required scope: write_products.
SHOPIFY_STORE_URL=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=